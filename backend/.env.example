APP_NAME=RecoverAI
ENVIRONMENT=development
# DATABASE_URL is intentionally left unset here. The app computes a safe,
# absolute default automatically (backend/app/config.py), independent of
# whichever directory you launch it from. Only set this explicitly if you
# want to point at something else (e.g. a real Postgres URL in production).
GROQ_API_KEY=
# Must be TEST MODE keys - key_id starts with rzp_test_, never rzp_live_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=